<Project>
  <!-- Keep IDE/MSBuild compilation aligned with the legacy exclusions in build.txt. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == '伊蕾娜'">
    <Compile Remove="Items/gItem.cs;Items/accessories/魔力共享戒指.cs;Items/accessories/白河豚项链.cs;Items/accessories/妮可的冒险谭.cs;Projectiles/**/*.cs;gnpc.cs;Buffs/冻结.cs;Buffs/灼烧.cs;Dusts/水花粒子.cs;Items/小动物药水.cs;ReProjs/MissileSpawner.cs;ReProjs/Wind/风刃黑洞.cs" />
    <!-- tMLMod.targets explicitly includes PNG/TXT/FX files, including preview outputs.
         Keep tool sources browsable, but keep them out of the Roslyn analyzer inputs. -->
    <AdditionalFiles Remove=".vissandbox/**;Tools/**" />
    <Compile Remove=".vissandbox/**/*.cs;Tools/**/*.cs" />
    <None Remove=".vissandbox/**" />
    <Content Remove=".vissandbox/**" />
    <EmbeddedResource Remove=".vissandbox/**" />
  </ItemGroup>
</Project>
