OnlyNotebook: 在配方手记中研究并制作

Crafting: {
	FacsimileSubstitution: 将以灰赝尘替代缺失材料制作
	FacsimileSubstitutionPriority: 将优先以灰赝尘替代材料制作（每种保留1个）
	FacsimileCost: 本次制作预计消耗灰赝尘{0}份（省料效果可能降低消耗）
	FacsimileModeMaterials: 当前模式：优先使用原版材料（右键灰赝尘切换）
	FacsimileModeDust: 当前模式：优先使用灰赝尘，每种材料保留1个（右键灰赝尘切换）
}

Buffs: {
	PainkillerBuff: {
		DisplayName: 止痛
		Description: 每秒恢复最大生命值的1%
	}

	BloodthirstBuff: {
		DisplayName: 嗜血
		Description: 受到的伤害提高20%，获得5%近战生命偷取，近战伤害提高10%
	}

	MoonDewElixirBuff: {
		DisplayName: 月露合剂
		Description: 每秒恢复最大[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]的1%
	}

	StarPowerBuff: {
		DisplayName: 星力
		Description: 最大魔力增加40；最大魔力或[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]越高于生命值，魔法伤害越高，最高提高30%
	}

	ConcentrationBuff: {
		DisplayName: 集中
		Description: 远程射击方向越接近目标中心，伤害越高；30度内从5%提高至30%
	}

	ResonanceBuff: {
		DisplayName: 共鸣
		Description: 鞭击施加3秒共鸣标记，你的召唤物对标记目标伤害增加20%
	}

	FeatherlightBuff: {
		DisplayName: 轻羽
		Description: 移动、翅膀飞行和扫帚速度增加20%
	}
}
