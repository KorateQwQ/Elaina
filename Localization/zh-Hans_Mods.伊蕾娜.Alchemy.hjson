Items: {
	AshenFacsimileDust: {
		DisplayName: 灰赝尘
		Tooltip:
			'''
			炼金造物
			常规合成时，每种材料至少持有1件，且各项满足比例的平均值达到50%，即可补足缺料
			每缺少1件材料消耗1份灰赝尘；材料齐全时不消耗
			仍需满足工作台和配方条件，不作用于伊蕾娜的炼金系统
			'''
	}

	Painkiller: {
		DisplayName: 止痛药
		Tooltip: 每秒恢复最大生命值的2%
	}

	BloodthirstPotion: {
		DisplayName: 嗜血药剂
		Tooltip:
			'''
			受到的伤害提高20%
			近战攻击获得5%生命偷取
			近战伤害提高10%
			'''
	}

	StarPowerPotion: {
		DisplayName: 星力药水
		Tooltip: 每有1点最大魔力，魔法伤害提高0.05%
	}
}

