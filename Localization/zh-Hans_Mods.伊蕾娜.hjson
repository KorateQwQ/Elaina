	扫帚坐骑: {
		DisplayName: 旅行魔女的扫帚
		Tooltip:
			'''
			召唤一把可以骑乘的扫帚
			习得[c/8FD3FF:飞行魔法]后，可用扫帚加速键长按加速、短按冲刺
			“骑着扫帚划过天空的魔女是谁呢？没错，就是我。”
			'''
	}

	寒霜药水: {
