Items: {
	ElainaHat: {
		DisplayName: 伊蕾娜的帽子
		Tooltip:
			'''
			魔法伤害提高10%
			魔力消耗减少15%
			增加20最大魔力值
			'''
	}

	妮可的冒险谭: {
		DisplayName: 妮可的冒险谭
		Tooltip: 每当你击败一个不同的boss，对所有boss类型的敌人造成的魔法伤害就增加1%
	}

	白河豚项链: {
		DisplayName: 白河豚项链
		Tooltip:
			'''
			魔法伤害提高10%
			白河豚的力量会在你濒死时为你抵挡致命伤害，冷却时间5分钟
			即将受到弹幕伤害时，自动展开护盾
			延长受伤后无敌状态时间
			'''
	}

	魔力共享戒指: {
		DisplayName: 魔力共享戒指
		Tooltip:
			'''
			最大魔力增加20
			魔力消耗减少20%
			共享魔力（此效果在时装位也会生效）
			'''
	}

