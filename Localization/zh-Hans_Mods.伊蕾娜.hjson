Items: {
	BookOfOblivion: {
		DisplayName: 忘却之书
		Tooltip:
			'''
			记载着如何让魔法从记忆中淡去的书
			持有时，可在技能手札的技能详情中选择忘却
			已习得技能退回 1 级，返还进修花费的研习点
			'''
	}

	ElainaHat: {
		DisplayName: 伊蕾娜的帽子
		Tooltip:
			'''
			魔法伤害提高10%
			魔法暴击率提高5%
			伊蕾娜的[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]上限增加20
			'''
	}

	妮可的冒险谭: {
		DisplayName: 妮可的冒险谭
		Tooltip: 每当你击败一个不同的boss，对所有boss类型的敌人造成的魔法伤害就增加1%
	}

	白河豚项链: {
		DisplayName: 白河豚项链
		Tooltip:
			'''
			魔法伤害提高10%
			白河豚的力量会在你濒死时为你抵挡致命伤害，冷却时间5分钟
			即将受到弹幕伤害时，自动展开护盾
			延长受伤后无敌状态时间
			'''
	}

	魔力共享戒指: {
		DisplayName: 魔力共享戒指
		Tooltip:
			'''
			最大魔力增加20
			魔力消耗减少20%
			共享魔力（此效果在时装位也会生效）
			'''
	}

	wand: {
		DisplayName: 魔杖
		// Tooltip: ""
	}

	小动物药水: {
		DisplayName: 小动物药水
