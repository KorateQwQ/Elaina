Terms: {
	MagicPower: {
		Name: 魔力
		Description:
			'''
			伊蕾娜开启灰之魔女后，施放技能所消耗的独特魔力。每1点原版最大魔力，以及灰之魔女减少的每1点生命上限，各提供1点上限。
			每秒自动回复{0}点＋最大值的{1:0.##}%，施法时也不会停止回复。施法、命中或受到伤害后{2}秒内视为战斗中；脱离战斗后，魔力恢复大幅提升，约{3:0.##}秒即可回满。
			地图上若还有存活的Boss，始终不会视为脱离战斗。
			'''
	}
}
