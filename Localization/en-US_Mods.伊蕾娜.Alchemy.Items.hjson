AshenFacsimileDust: {
	DisplayName: Ashen Facsimile Dust
	Tooltip:
		'''
		An alchemical creation
		For normal crafting, carry at least one of each ingredient and fulfill an average of 50% of ingredient requirements
		Consumes 1 dust per missing ingredient unit; consumes none when all materials are available
		Still requires crafting stations and recipe conditions; does not affect Elaina's alchemy system
		'''
}

Painkiller: {
	DisplayName: Painkiller
	Tooltip: Restores 1% of maximum life per second
}

BloodthirstPotion: {
	DisplayName: Bloodthirst Potion
	Tooltip:
		'''
		Increases damage taken by 20%
		Grants 5% melee life steal
		Increases melee damage by 10%
		'''
}

StarPowerPotion: {
	DisplayName: Star Power Potion
	Tooltip:
		'''
		Increases maximum mana by 40
		The more your maximum mana or [klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:Magic Power] exceeds your life, the more magic damage you deal, up to +30%
		Mana-life difference needed for the maximum bonus: 300
		'''
}

MoonDewElixir: {
	DisplayName: Moon Dew Elixir
	Tooltip:
		'''
		For Elaina
		Restores 1% of maximum [klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:Magic Power] per second
		'''
}

ConcentrationPotion: {
	DisplayName: Concentration Potion
	Tooltip:
		'''
		Ranged attacks deal more damage when aimed closer to the center of a target
		Damage bonus: +5% to +30%
		Maximum angle: 30 degrees
		'''
}

ResonancePotion: {
	DisplayName: Resonance Potion
	Tooltip:
		'''
		Whip hits mark enemies with Resonance for 3 seconds
		Your minions and sentries deal 20% more damage to marked enemies
		'''
}

FeatherlightPotion: {
	DisplayName: Featherlight Potion
	Tooltip: Movement, wing flight, and broom speed: +20%
}

PurificationDew: {
	DisplayName: Purification Dew
	Tooltip:
		'''
		Drip onto a block to purify it and every block below it
		Creates a vertical barrier against biome spread
		Planned availability: early Hardmode
		Effects not implemented yet
		'''
}

AetherDropper: {
	DisplayName: Aether Dropper
	Tooltip:
		'''
		A reusable tool for holding shimmer safely
		Capacity: 1 tile of shimmer
		First use absorbs shimmer; the next releases it
		Also obtains Shimmer Droplets
		Planned availability: after defeating any mechanical boss
		Effects not implemented yet
		'''
}

RevealingDust: {
	DisplayName: Revealing Dust
	Tooltip:
		'''
		Scatter sparkling dust to expose hidden danger
		Marks nearby hostile creatures and traps
		Planned availability: the Hallow in Hardmode
		Effects not implemented yet
		'''
}

BottledRain: {
	DisplayName: Bottled Rain
	Tooltip:
		'''
		Break the bottle to release a small rain cloud for 45 seconds
		Covers an area approximately 20 tiles wide
		Extinguishes ordinary On Fire! and waters nearby plants
		Makes Waterleaf bloom and accelerates plant growth
		Planned availability: after exploring the sky
		Effects not implemented yet
		'''
}

HoneyBread: {
	DisplayName: Honey Bread
	Tooltip:
		'''
		Look at that golden color, smell that irresistible sweet aroma… I've outdone myself.
		Elaina: Plenty Satisfied and restores 30 life
		Other characters: Well Fed without life restoration
		'''
}

BeefStew: {
	DisplayName: Beef Stew
	Tooltip:
		'''
		Tender beef and soft potatoes—this is one of my specialties
		Still, I look forward to dessert even more
		Grants Exquisitely Stuffed
		'''
}

CaramelBrulee: {
	DisplayName: Caramel Brulee
	Tooltip:
		'''
		A delicate custard hidden beneath a crisp caramel shell
		Grants Well Fed
		'''
}

MoonDew: {
	DisplayName: Moon Dew
	Tooltip:
		'''
		An alchemical base made by steeping Moonglow in Bottled Water
		Used for mana, stars and spatial alchemy
		Planned recipe: 3 Bottled Water + 1 Moonglow yields 3 Moon Dew
		Effects not implemented yet
		'''
}

WarmResin: {
	DisplayName: Warm Resin
	Tooltip:
		'''
		Slowly simmer wood and gel to obtain a warm, mildly sweet resin
		Used for salves, incense and broom maintenance
		Planned recipe: 20 Wood + 2 Gel yields 2 Warm Resin
		Effects not implemented yet
		'''
}

Flour: {
	DisplayName: Flour
	Tooltip:
		'''
		Fine white baking flour suitable for sweet dough
		Used for Honey Bread
		Planned source: sold by the Merchant
		Effects not implemented yet
		'''
}

Sugar: {
	DisplayName: Sugar
	Tooltip:
		'''
		Sweetens dough and forms a crisp caramel crust when cooked
		Used for Honey Bread and Caramel Brulee
		Planned source: sold by the Merchant
		Effects not implemented yet
		'''
}

Egg: {
	DisplayName: Egg
	Tooltip:
		'''
		A basic cooking and baking ingredient
		Used for Caramel Brulee
		Planned source: sold by the Merchant
		Effects not implemented yet
		'''
}

Beef: {
	DisplayName: Beef
	Tooltip:
		'''
		Beef suitable for a long, slow simmer
		Used for Beef Stew
		Planned source: always offered when the Traveling Merchant visits
		Effects not implemented yet
		'''
}

Potato: {
	DisplayName: Potato
	Tooltip:
		'''
		Turns soft and fluffy while soaking up the flavor of the broth
		Used for Beef Stew
		Planned source: always offered when the Traveling Merchant visits
		Effects not implemented yet
		'''
}

ShimmerDroplet: {
	DisplayName: Shimmer Droplet
	Tooltip:
		'''
		A strange drop from shimmer with a faint power of transmutation
		Used for Ashen Facsimile Dust
		Planned source: collected from shimmer using the Aether Dropper
		Effects not implemented yet
		'''
}
