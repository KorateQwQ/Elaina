Items: {
	BookOfOblivion: {
		DisplayName: Book of Oblivion
		Tooltip:
			'''
			A book on letting a spell fade from memory
			While carried, a Forget option appears in the skill notebook's details
			Returns a learned skill to level 1 and refunds the Study Points spent on its upgrades
			'''
	}

	ElainaHat: {
		DisplayName: Elaina Hat
		Tooltip:
			'''
			10% increased magic damage
			5% increased magic critical strike chance
			Increases Elaina's maximum [klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:Magic Power] by 20
			'''
	}

	妮可的冒险谭: {
		DisplayName: The Adventures of Nikeh
		Tooltip: ""
	}

	白河豚项链: {
		DisplayName: White dolphin necklace
		Tooltip:
			'''
			The necklace will protect you when you face death, 5 min cd
			The barrier will automatically activate when you are hit by a projectile
			Increases length of invincibility after taking damage
			10% increased magic damage

			'''
	}

	魔力共享戒指: {
		DisplayName: Magic Sharing Ring
		Tooltip:
			'''
			Share mana with players who also have this item, the maximum magic power will be increased by 20
			and the mana usage rate will be reduced by 20%, the mana sharing effect will also take effect in the fashion position.

			'''
	}

