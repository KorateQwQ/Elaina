Items: {
	AshenFacsimileDust: {
		DisplayName: Ashen Facsimile Dust
		Tooltip:
			'''
			An alchemical creation
			For normal crafting, carry at least one of each ingredient and fulfill an average of 50% of ingredient requirements
			Consumes 1 dust per missing ingredient unit; consumes none when all materials are available
			Still requires crafting stations and recipe conditions; does not affect Elaina's alchemy system
			'''
	}

	Painkiller: {
		DisplayName: Painkiller
		Tooltip: Regenerates 2% of maximum life per second
	}

	BloodthirstPotion: {
		DisplayName: Bloodthirst Potion
		Tooltip:
			'''
			Increases damage taken by 20%
			Grants 5% melee life steal
			Increases melee damage by 10%
			'''
	}

	StarPowerPotion: {
		DisplayName: Star Power Potion
		Tooltip: Increases magic damage by 0.05% for each point of maximum mana
	}
}

Crafting: {
	FacsimileCost: Selected recipe: {0} dust needed ({1:0.#}% materials fulfilled; conservation effects may reduce the cost)
}

Buffs: {
	PainkillerBuff: {
		DisplayName: Pain Relief
		Description: Regenerates 2% of maximum life per second
	}

	BloodthirstBuff: {
		DisplayName: Bloodthirst
		Description: 20% increased damage taken, 5% melee life steal, and 10% increased melee damage
	}

	StarPowerBuff: {
		DisplayName: Star Power
		Description: Magic damage increased by 0.05% for each point of maximum mana
	}
}
