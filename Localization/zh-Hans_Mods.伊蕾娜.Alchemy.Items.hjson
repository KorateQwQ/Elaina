AshenFacsimileDust: {
	DisplayName: 灰赝尘
	Tooltip:
		'''
		炼金造物
		以微光嬗变之力补全不足的素材
		每种所需材料至少持有1件，所有所需素材的满足平均值大于50%
		通过收藏可以在合成时优先使用灰赝尘替代原材料
		'''
}

Painkiller: {
	DisplayName: 止痛药
	Tooltip: 每秒恢复最大生命值的1%
}

PainkillerRecipe: {
	DisplayName: 止痛药配方
	Tooltip: 藏在丛林常春藤宝箱中的药剂笔记，记载着持续恢复生命的炼制方法。
}

BloodthirstPotionRecipe: {
	DisplayName: 嗜血药水配方
	Tooltip: 记载着以血气激发近战潜能的炼制方法。
}

StarPowerPotionRecipe: {
	DisplayName: 星力药水配方
	Tooltip: 记载着将星辰之力融入魔力的炼制方法。
}

ConcentrationPotionRecipe: {
	DisplayName: 集中药水配方
	Tooltip: 记载着凝聚心神、使瞄准更加致命的炼制方法。
}

ResonancePotionRecipe: {
	DisplayName: 共鸣药水配方
	Tooltip: 记载着让鞭击与召唤物产生共鸣的炼制方法。
}

FeatherlightPotionRecipe: {
	DisplayName: 轻羽药水配方
	Tooltip: 藏在地下金宝箱中的旅人笔记，记载着让步伐与飞行更加轻快的炼制方法。
}

BloodthirstPotion: {
	DisplayName: 嗜血药水
	Tooltip:
		'''
		受到的伤害提高20%
		近战攻击获得5%生命偷取
		近战伤害提高10%
		'''
}

StarPowerPotion: {
	DisplayName: 星力药水
	Tooltip:
		'''
		最大魔力增加40
		最大魔力或[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]越高于生命值，魔法伤害越高，最高提高30%
		最大加成所需生命差值：300
		'''
}

MoonDewElixir: {
	DisplayName: 月露合剂
	Tooltip:
		'''
		仅供伊蕾娜使用
		每秒恢复最大[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]的1%
		'''
}

ConcentrationPotion: {
	DisplayName: 集中药水
	Tooltip:
		'''
		魔药 · 战斗
		你的远程攻击方向距离目标中心越近，造成的伤害就越高。
		伤害增幅：+5% ~ +30%
		最大判定角度：30 度
		'''
}

ResonancePotion: {
	DisplayName: 共鸣药水
	Tooltip:
		'''
		魔药 · 战斗
		鞭子命中敌人后赋予共鸣标记，你的召唤物攻击被共鸣的敌人时伤害增加。
		标记时间：3 秒
		召唤物伤害：+20%
		'''
}

FeatherlightPotion: {
	DisplayName: 轻羽药水
	Tooltip:
		'''
		魔药 · 功能
		使你变得身轻如燕，移动速度、飞行速度和扫帚速度增加。
		速度增幅：+20%
		'''
}

PurificationDew: {
	DisplayName: 净土露滴
	Tooltip:
		'''
		魔药 · 功能
		使用后在目标位置滴下净土露滴，其会下落穿透物块并净化附近所有物块。
		作用范围：附近所有物块
		特性：下落时穿透物块
		'''
}

AetherDropper: {
	DisplayName: 以太滴管
	Tooltip: 可以提取少量微光
}

RevealingDust: {
	DisplayName: 显迹尘
	Tooltip:
		'''
		奇物 · 功能
		照亮所有敌人与陷阱。
		照亮半径：1500
		持续时间：120 秒
		'''
}

BottledRain: {
	DisplayName: 瓶中雨
	Tooltip:
		'''
		奇物 · 功能
		释放一朵便携雨云，增快附近所有植物的生长，让水叶草开花。
		持续时间：60 秒
		'''
}

