AshenFacsimileDust: {
	DisplayName: 灰赝尘
	Tooltip:
		'''
		以微光嬗变之力补全不足的素材
		每种所需材料至少持有1件即可使用
		选中配方后左键按原版制作，右键使用灰赝尘制作
		'''
}

Painkiller: {
	DisplayName: 止痛药
	Tooltip: 每秒恢复最大生命值的1%
}

PainkillerRecipe: {
	DisplayName: 止痛药配方
	Tooltip: 记载着持续恢复生命的炼制方法
}

BloodthirstPotionRecipe: {
	DisplayName: 嗜血药水配方
	Tooltip: 记载着以血气激发近战潜能的炼制方法
}

StarPowerPotionRecipe: {
	DisplayName: 星力药水配方
	Tooltip: 记载着将星辰之力融入魔力的炼制方法
}

ConcentrationPotionRecipe: {
	DisplayName: 集中药水配方
	Tooltip: 记载着凝聚心神、使瞄准更加致命的炼制方法
}

ResonancePotionRecipe: {
	DisplayName: 共鸣药水配方
	Tooltip: 记载着让鞭击与召唤物产生共鸣的炼制方法
}

PurificationDewRecipe: {
	DisplayName: 净土露滴配方
	Tooltip: 记载着净土露滴的炼制方法
}

FeatherlightPotionRecipe: {
	DisplayName: 轻羽药水配方
	Tooltip: 记载着让步伐与飞行更加轻快的炼制方法
}

BloodthirstPotion: {
	DisplayName: 嗜血药水
	Tooltip:
		'''
		受到的伤害提高20%
		近战攻击获得5%生命偷取
		近战伤害提高10%
		'''
}

StarPowerPotion: {
	DisplayName: 星力药水
	Tooltip:
		'''
		最大魔力增加40
		最大魔力或[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]越高于生命值，魔法伤害越高，最高提高30%
		'''
}

MoonDewElixir: {
	DisplayName: 月露合剂
	Tooltip:
		'''
		仅供伊蕾娜使用
		每秒恢复最大[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]的1%
		'''
}

ConcentrationPotion: {
	DisplayName: 集中药水
	Tooltip:
		'''
		远程攻击方向越接近目标中心，伤害越高
		在 30 度内，伤害从 5% 提高至 30%
		'''
}

ResonancePotion: {
	DisplayName: 共鸣药水
	Tooltip:
		'''
		鞭子命中敌人时施加 3 秒共鸣标记
		你的召唤物对被标记的敌人伤害提高20%
		'''
}

FeatherlightPotion: {
	DisplayName: 轻羽药水
	Tooltip: 移动、翅膀飞行和扫帚速度提高20%
}

PurificationDew: {
	DisplayName: 净土露滴
	Tooltip:
		'''
		在目标位置滴下一道彩虹露光
		经过的区域永久抵御感染
		'''
}

AetherDropper: {
	DisplayName: 以太滴管
	Tooltip: 可以提取少量微光
}

RevealingDust: {
	DisplayName: 显迹尘
	Tooltip:
		'''
		洒下金尘，留下持续 5 分钟的显迹区域
		高亮区域内的危险物块，并使敌人显形 5 分钟
		'''
}

BottledRain: {
	DisplayName: 瓶中雨
	Tooltip:
		'''
		投掷后释放一朵持续 60 秒的便携雨云
		加速雨幕内植物生长，让成熟的{$ItemName.Waterleaf}开花
		'''
}

HoneyBread: {
	DisplayName: 蜂蜜面包
	Tooltip:
		'''
		{$CommonItemTooltip.MinorStats}
		伊蕾娜食用时所有属性中幅提升，并额外获得5分钟开心
		“{$Mods.伊蕾娜.UI.Catalog.HoneyDrizzledBreadOneOfElainaSFavoriteSweetProvisionsItsEffectsV}”
		'''
}

BeefStew: {
	DisplayName: 炖菜
	Tooltip:
		'''
		{$CommonItemTooltip.MajorStats}
		“{$Mods.伊蕾娜.UI.Catalog.AWarmingBeefAndPotatoStewThatElainaMakesWellThoughItIsNotHerFavo}”
		'''
}

CaramelBrulee: {
	DisplayName: 焦糖布蕾
	Tooltip:
		'''
		{$CommonItemTooltip.MinorStats}
		“{$Mods.伊蕾娜.UI.Catalog.CrackTheDelicateCaramelCrustToRevealASilkyCustardBeneath}”
		'''
}

MoonDew: {
	DisplayName: 月露
	Tooltip: 用{$ItemName.BottledWater}与{$ItemName.Moonglow}制成的药液基底，可用于各种药水
}

Flour: {
	DisplayName: 面粉
	Tooltip: 细白的烘焙用面粉，适合揉成甜面团
}

Sugar: {
	DisplayName: 糖
	Tooltip: 给面团带来甜味，熬煮后也能形成焦糖外壳
}

Egg: {
	DisplayName: 鸡蛋
	Tooltip: 料理与烘焙的基础食材
}

Beef: {
	DisplayName: 牛肉
	Tooltip: 适合长时间炖煮的牛肉
}

Potato: {
	DisplayName: 土豆
	Tooltip: 炖煮后软糯绵密，能吸足肉汤的味道
}

BottledShimmer: {
	DisplayName: 瓶中微光
	Tooltip:
		'''
		以太滴管提取的瓶装微光
		可以倒出少量微光
		'''
}
