AshenFacsimileDust: {
	DisplayName: 灰赝尘
	Tooltip:
		'''
		炼金造物
		以微光嬗变之力补全不足的素材
		每种所需材料至少持有1件即可使用
		选中配方后左键按原版制作，右键使用灰赝尘制作
		'''
}

Painkiller: {
	DisplayName: 止痛药
	Tooltip: 每秒恢复最大生命值的1%
}

PainkillerRecipe: {
	DisplayName: 止痛药配方
	Tooltip: 记载着持续恢复生命的炼制方法。
}

BloodthirstPotionRecipe: {
	DisplayName: 嗜血药水配方
	Tooltip: 记载着以血气激发近战潜能的炼制方法。
}

StarPowerPotionRecipe: {
	DisplayName: 星力药水配方
	Tooltip: 记载着将星辰之力融入魔力的炼制方法。
}

ConcentrationPotionRecipe: {
	DisplayName: 集中药水配方
	Tooltip: 记载着凝聚心神、使瞄准更加致命的炼制方法。
}

ResonancePotionRecipe: {
	DisplayName: 共鸣药水配方
	Tooltip: 记载着让鞭击与召唤物产生共鸣的炼制方法。
}

PurificationDewRecipe: {
	DisplayName: 净土露滴配方
	Tooltip: 记载着净土露滴的炼制方法。
}

FeatherlightPotionRecipe: {
	DisplayName: 轻羽药水配方
	Tooltip: 记载着让步伐与飞行更加轻快的炼制方法。
}

BloodthirstPotion: {
	DisplayName: 嗜血药水
	Tooltip:
		'''
		受到的伤害提高20%
		近战攻击获得5%生命偷取
		近战伤害提高10%
		'''
}

StarPowerPotion: {
	DisplayName: 星力药水
	Tooltip:
		'''
		最大魔力增加40
		最大魔力或[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]越高于生命值，魔法伤害越高，最高提高30%
		最大加成所需生命差值：300
		'''
}

MoonDewElixir: {
	DisplayName: 月露合剂
	Tooltip:
		'''
		仅供伊蕾娜使用
		每秒恢复最大[klicon/16,0:伊蕾娜/Snippets/MagicStarIcon][c/4C91FFFF:魔力]的1%
		'''
}

ConcentrationPotion: {
	DisplayName: 集中药水
	Tooltip:
		'''
		魔药 · 战斗
		你的远程攻击方向距离目标中心越近，造成的伤害就越高。
		伤害增幅：+5% ~ +30%
		最大判定角度：30 度
		'''
}

ResonancePotion: {
	DisplayName: 共鸣药水
	Tooltip:
		'''
		魔药 · 战斗
		鞭子命中敌人后赋予共鸣标记，你的召唤物攻击被共鸣的敌人时伤害增加。
		标记时间：3 秒
		召唤物伤害：+20%
		'''
}

FeatherlightPotion: {
	DisplayName: 轻羽药水
	Tooltip:
		'''
		魔药 · 功能
		使你变得身轻如燕，移动速度、飞行速度和扫帚速度增加。
		速度增幅：+20%
		'''
}

PurificationDew: {
	DisplayName: 净土露滴
	Tooltip:
		'''
		在目标位置滴下一道彩虹露光，穿透物块并向下净化至世界底部
		净化宽度为三格：目标列及左右各一列，不改变背景墙
		经过的区域永久抵御腐化、猩红与神圣感染，阻止感染荆棘和藤蔓侵入
		保护随世界保存，挖除后重新放置物块仍然有效
		'''
}

AetherDropper: {
	DisplayName: 以太滴管
	Tooltip: 可以提取少量微光
}

RevealingDust: {
	DisplayName: 显迹尘
	Tooltip:
		'''
		奇物 · 功能
		洒下金尘，留下持续 5 分钟的显迹区域
		高亮区域内的危险物块，并使敌人显形 5 分钟
		'''
}

BottledRain: {
	DisplayName: 瓶中雨
	Tooltip:
		'''
		奇物 · 功能
		投掷后释放一朵便携雨云，加速雨幕内植物生长，让成熟的{$ItemName.Waterleaf}开花。
		雨幕宽约 20 格，受实心物块阻挡。
		持续时间：60 秒
		'''
}

HoneyBread: {
	DisplayName: 蜂蜜面包
	Tooltip:
		'''
		{$CommonItemTooltip.MinorStats}
		伊蕾娜食用时所有属性中幅提升，并额外获得5分钟开心
		“{$Mods.伊蕾娜.UI.Catalog.HoneyDrizzledBreadOneOfElainaSFavoriteSweetProvisionsItsEffectsV}”
		'''
}

BeefStew: {
	DisplayName: 炖菜
	Tooltip:
		'''
		{$CommonItemTooltip.MajorStats}
		“{$Mods.伊蕾娜.UI.Catalog.AWarmingBeefAndPotatoStewThatElainaMakesWellThoughItIsNotHerFavo}”
		'''
}

