	Tooltip:
		'''
		新食材 · 旅商固定售卖
		适合长时间炖煮的牛肉。
		用于：炖菜
		计划获取方式：旅行商人到访时固定售卖。
		效果尚未实现
		'''
}

Potato: {
	DisplayName: 土豆
	Tooltip:
		'''
		新食材 · 旅商固定售卖
		炖煮后软糯绵密，能吸足肉汤的味道。
		用于：炖菜
		计划获取方式：旅行商人到访时固定售卖。
		效果尚未实现
		'''
}

ShimmerDroplet: {
	DisplayName: 微光液滴
	Tooltip:
		'''
		新素材 · 微光凝滴
		从微光中取得的一滴奇异液体，带着转化物质的微弱力量。
		用于：灰赝尘
		计划获取方式：使用以太滴管从微光中取得。
