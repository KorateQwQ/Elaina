ConcentrationPotion: {
	DisplayName: 集中药水
	Tooltip:
		'''
		魔药 · 战斗
		你的远程攻击方向距离目标中心越近，造成的伤害就越高。
		伤害增幅：+5% ~ +30%
		最大判定角度：30 度
		'''
}

ResonancePotion: {
	DisplayName: 共鸣药水
	Tooltip:
		'''
		魔药 · 战斗
		鞭子命中敌人后赋予共鸣标记，你的召唤物攻击被共鸣的敌人时伤害增加。
		标记时间：3 秒
		召唤物伤害：+20%
		'''
}

FeatherlightPotion: {
	DisplayName: 轻羽药水
	Tooltip:
		'''
		魔药 · 功能
		使你变得身轻如燕，移动速度、飞行速度和扫帚速度增加。
		速度增幅：+20%
		'''
}

PurificationDew: {
	DisplayName: 净土露滴
	Tooltip:
		'''
		魔药 · 功能
		使用后在目标位置滴下净土露滴，其会下落穿透物块并净化附近所有物块。
		作用范围：附近所有物块
		特性：下落时穿透物块
		'''
}

AetherDropper: {
	DisplayName: 以太滴管
	Tooltip:
		'''
		奇物 · 功能
		可以吸收并重新释放微光。
		容量：1 格微光
		'''
}

RevealingDust: {
	DisplayName: 显迹尘
	Tooltip:
		'''
		奇物 · 功能
		照亮所有敌人与陷阱。
		照亮半径：1500
		持续时间：120 秒
		'''
}

BottledRain: {
	DisplayName: 瓶中雨
	Tooltip:
		'''
		奇物 · 功能
		释放一朵便携雨云，增快附近所有植物的生长，让水叶草开花。
		持续时间：60 秒
		'''
}

HoneyBread: {
	DisplayName: 蜂蜜面包
	Tooltip:
		'''
		料理 · 辅助
		淋上蜂蜜的面包，是伊蕾娜喜欢的甜味补给。不同旅人食用时获得的效果有所不同。
		伊蕾娜：酒足饭饱 · 恢复 50 生命
		其他玩家：吃得好 · 不回复生命
		计划获取方式：基础料理
		效果尚未实现
		'''
}

BeefStew: {
	DisplayName: 炖菜
	Tooltip:
		'''
		料理 · 辅助
		伊蕾娜擅长制作的牛肉土豆炖菜。炖得软烂又暖胃，不过并不是她最偏爱的食物。
		食用效果：很满意
		计划获取方式：旅商食材
		效果尚未实现
		'''
}

CaramelBrulee: {
	DisplayName: 焦糖布蕾
	Tooltip:
		'''
		料理 · 辅助
		轻轻敲开薄脆的焦糖外壳，下面是柔软细腻的蛋奶甜点。
		食用效果：吃得好
		计划获取方式：基础料理
		效果尚未实现
		'''
}

MoonDew: {
	DisplayName: 月露
	Tooltip:
		'''
		素材
		用瓶装水与月光草制成的药液基底，可直接用于炼金。
		'''
}

WarmResin: {
	DisplayName: 温香树脂
	Tooltip:
		'''
		素材
		木材和凝胶熬制成的温润树脂。
		'''
}

Flour: {
	DisplayName: 面粉
	Tooltip:
		'''
		新食材 · 商人售卖
		细白的烘焙用面粉，适合揉成甜面团。
		用于：蜂蜜面包
		计划获取方式：向商人购买。
		效果尚未实现
		'''
}

