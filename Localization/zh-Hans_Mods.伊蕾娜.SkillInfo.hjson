SkillName: {
	MagicMissileSkill: 魔法飞弹
	MultiMissileSkill: 多重射击
	AshenWitchSkill: 灰之魔女
	MagicBarrierSkill: 魔力护盾
}

SkillDesc: {
	MagicMissileSkill:
		'''
		对目标造成{0}魔法伤害
		被动: 魔法飞弹连续命中5次后额外造成基于魔法飞弹200%伤害的额外伤害。
		'''
	MultiMissileSkill: 对目标造成魔法伤害
	AshenWitchSkill: 玩家额外生命收益减少50%，每当以这种方式损失1点生命值，额外增加{0}%[c/4C91FFFF:最大魔力值]。
	MagicBarrierSkill:
		'''
		获得拥有[c/4C91FFFF:{0} + 最大魔力的{1}%]护盾值的魔力护盾。

		只要护盾仍有护盾值，受到攻击或持续掉血效果时便会消耗等同于最终伤害的护盾值，并[c/FFD166:完全抵挡该次伤害]。超过剩余护盾值的伤害不会穿透护盾。

		护盾每秒恢复最大护盾值的[c/4C91FFFF:{2}%]。护盾完全破碎后进入[c/FFD166:{3}秒]冷却，冷却期间无法恢复护盾。
		'''
}

SkillType: {
	Active: 主动技能
	Passive: 被动技能
	Derived: 派生技能
}

